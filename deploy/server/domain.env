# The public host name of the grid and the ACME contact: the one place to change them on the server.
# Install as /etc/gpu-goblin/domain.env (mode 0644). Read by Caddy (caddy-gpu-goblin.conf), by the
# health check (gg-healthcheck.sh) and by gg-server (GG_PUBLIC_URL: links in e-mails, the CLI command
# shown with a new token). After a change: systemctl restart caddy gg-server
GG_DOMAIN=grid.gpugoblin.com
GG_PUBLIC_URL=https://grid.gpugoblin.com
GG_ACME_EMAIL=admin@gpugoblin.com
