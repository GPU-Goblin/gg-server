# Daily backup of the GPU Goblin server. Install as /etc/systemd/system/gg-backup.service with
# gg-backup.timer; the script goes to /usr/local/lib/gpu-goblin/gg-backup.sh.
[Unit]
Description=GPU Goblin backup (database dump and object store)
After=postgresql@17-main.service gg-server.service

[Service]
Type=oneshot
User=gg
Group=gg
ExecStart=/usr/local/lib/gpu-goblin/gg-backup.sh backup
Nice=10
IOSchedulingClass=idle

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/gpu-goblin
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
