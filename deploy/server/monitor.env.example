# Copy to /etc/gpu-goblin/monitor.env, owner root, mode 0600. systemd reads it as root before starting
# the check as the gg user, so the token never sits in a file gg can read.
# Create the token on the server with:  sudo -u gg gg-server --config /etc/gpu-goblin/server.toml bootstrap-admin --label monitor
GG_MONITOR_TOKEN=<admin token for the health check>
