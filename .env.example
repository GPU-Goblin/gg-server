# Copy to .env for local development. Never commit .env.
# PostgreSQL started by `cargo xtask db up` (docker, localhost only).
DATABASE_URL=postgres://gg:gg_dev_password@127.0.0.1:5434/gpu_goblin
# Where the control server keeps artifacts and its signing key.
GG_DATA_DIR=./var/server
# Logical network identifier bound into every signature.
GG_NETWORK_ID=gg-dev-local
# Bind address of the control API.
GG_BIND_ADDR=127.0.0.1:8080
# Time a worker has to send the durable copy of an activation it passed on before (ADR-0026).
# GG_PENDING_OUTPUT_SECS=600
# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info,gg_control=debug,sqlx=warn
